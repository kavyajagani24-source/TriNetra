# UrbanEye AI — Environment Configuration
# Copy this file to .env and fill in the values.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=UrbanEye AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://urbaneye:urbaneye@localhost:5432/urbaneye

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=storage
UPLOAD_PATH=storage/uploads
PROCESSED_PATH=storage/processed
EVIDENCE_PATH=storage/evidence
THUMBNAIL_PATH=storage/thumbnails

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500

# ── Allowed Video Extensions ──────────────────────────────────────────────────
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# PHASE 2 — AI CONFIGURATION
# =============================================================================

# ── YOLO Object Detection ──────────────────────────────────────────────────────
# Model is auto-downloaded by Ultralytics on first use.
# Options: yolo11n.pt  yolo11s.pt  yolo11m.pt  yolo8n.pt  yolo8s.pt
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.40
YOLO_IOU_THRESHOLD=0.50
# cpu | 0 | 1 | cuda  (use 0 for first GPU, cpu for CPU-only environments)
YOLO_DEVICE=cpu
ENABLE_TRACKING=true
TRACKER_TYPE=bytetrack

# ── Video Processing ──────────────────────────────────────────────────────────
# 1=every frame | 2=every 2nd frame | 5=every 5th frame
# Higher values reduce accuracy but increase throughput.
PROCESS_EVERY_N_FRAMES=1
# Write progress to DB every N frames processed
PROGRESS_UPDATE_INTERVAL=30

# ── Trajectories ──────────────────────────────────────────────────────────────
MAX_TRAJECTORY_POINTS=100
# Save a trajectory point to DB every N frames
TRAJECTORY_SAVE_INTERVAL=5

# ── Detection Persistence ─────────────────────────────────────────────────────
# false = only save every DETECTION_SAVE_INTERVAL frames (recommended for perf)
# true  = save every single detection (high DB write volume)
SAVE_ALL_DETECTIONS=false
DETECTION_SAVE_INTERVAL=10

# ── Analytics ─────────────────────────────────────────────────────────────────
# Calculate and store traffic analytics every N frames
ANALYTICS_INTERVAL_FRAMES=30
# Active vehicle count thresholds for density classification
TRAFFIC_LOW_THRESHOLD=5
TRAFFIC_MEDIUM_THRESHOLD=10
TRAFFIC_HIGH_THRESHOLD=20

# ── Congestion ────────────────────────────────────────────────────────────────
CONGESTION_VEHICLE_THRESHOLD=15
CONGESTION_SPEED_THRESHOLD=10.0

# ── Visualization ─────────────────────────────────────────────────────────────
SAVE_ANNOTATED_VIDEO=true
DRAW_TRAJECTORIES=true
SAVE_DETECTION_EVIDENCE=true
# Save an evidence frame every N frames
EVIDENCE_SAVE_INTERVAL=150
